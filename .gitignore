# Local Windows SDK/toolchain workarounds. These are machine-specific: they exist only
# to work around a Visual Studio install that has the C++ tools but not the CRT/SDK
# libraries. See "Building" in README.md for the supported setup.
.tools/
.sdk-layout/
.sdk-env.sh
build-release.bat

